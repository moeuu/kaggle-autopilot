#!/usr/bin/env bash
set -euo pipefail

readonly service_names=(
  kagglebot-watch.service
)
readonly timer_names=(
  kagglebot-oracle-update.timer
)
readonly unit_names=(
  "${service_names[@]}"
  kagglebot-oracle-update.service
  "${timer_names[@]}"
)

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
runtime_root="${HOME}/.local/share/kagglebot-autopilot"
current_link="${runtime_root}/current"
uv_link="${runtime_root}/uv"
user_unit_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
command_name="${1:-install}"
enable_oracle_update=0
if [[ $# -gt 0 ]]; then
  shift
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    --enable-oracle-update) enable_oracle_update=1 ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      printf 'Usage: %s {install|start|stop|restart|status|uninstall} [--enable-oracle-update]\n' "$0" >&2
      exit 2
      ;;
  esac
  shift
done

if [[ "${enable_oracle_update}" == 1 && "${command_name}" != install ]]; then
  printf '%s\n' '--enable-oracle-update is only valid with install.' >&2
  exit 2
fi

require_systemd_user() {
  command -v systemctl >/dev/null 2>&1 || {
    printf 'systemctl is required.\n' >&2
    exit 1
  }
  systemctl --user show-environment >/dev/null
}

install_services() {
  require_systemd_user
  local uv_bin
  uv_bin="$(command -v uv || true)"
  if [[ -z "${uv_bin}" ]]; then
    printf 'uv is required: https://docs.astral.sh/uv/getting-started/installation/\n' >&2
    exit 1
  fi

  if [[ -e "${current_link}" && ! -L "${current_link}" ]]; then
    printf '%s exists and is not a symlink; move it before installing.\n' "${current_link}" >&2
    exit 1
  fi

  (cd "${repo_root}" && uv sync --frozen)
  mkdir -p "${runtime_root}" "${user_unit_dir}" "${HOME}/.config/kagglebot-autopilot"
  ln -sfn "${repo_root}" "${current_link}"
  ln -sfn "${uv_bin}" "${uv_link}"

  local unit_name
  for unit_name in "${unit_names[@]}"; do
    ln -sfn "${current_link}/deploy/systemd/${unit_name}" "${user_unit_dir}/${unit_name}"
  done
  rm -f "${user_unit_dir}/kagglebot-discord-notifier.service"

  systemctl --user daemon-reload
  systemctl --user enable "${service_names[@]}"
  if [[ "${enable_oracle_update}" == 1 ]]; then
    systemctl --user enable --now "${timer_names[@]}"
  else
    systemctl --user disable --now "${timer_names[@]}" 2>/dev/null || true
    printf 'Oracle auto-update timer is disabled; opt in with install --enable-oracle-update.\n'
  fi
  systemctl --user restart "${service_names[@]}"
  printf 'Installed from %s\n' "${repo_root}"
  status_services
}

start_services() {
  require_systemd_user
  systemctl --user daemon-reload
  systemctl --user start "${service_names[@]}"
  if systemctl --user is-enabled --quiet "${timer_names[0]}"; then
    systemctl --user start "${timer_names[@]}"
  fi
  status_services
}

stop_services() {
  require_systemd_user
  systemctl --user stop "${service_names[@]}"
  if systemctl --user is-enabled --quiet "${timer_names[0]}"; then
    systemctl --user stop "${timer_names[@]}"
  fi
}

restart_services() {
  require_systemd_user
  systemctl --user daemon-reload
  if systemctl --user is-enabled --quiet "${timer_names[0]}"; then
    systemctl --user restart "${timer_names[@]}"
  fi
  systemctl --user restart "${service_names[@]}"
  status_services
}

status_services() {
  require_systemd_user
  systemctl --user status "${service_names[@]}" --no-pager
  if systemctl --user is-enabled --quiet "${timer_names[0]}"; then
    systemctl --user status "${timer_names[@]}" --no-pager
  else
    printf 'Optional timer disabled: %s\n' "${timer_names[0]}"
  fi
}

uninstall_services() {
  require_systemd_user
  systemctl --user disable --now "${service_names[@]}" "${timer_names[@]}" 2>/dev/null || true
  local unit_name
  for unit_name in "${unit_names[@]}"; do
    rm -f "${user_unit_dir}/${unit_name}"
  done
  rm -f "${user_unit_dir}/kagglebot-discord-notifier.service"
  rm -f "${current_link}" "${uv_link}"
  systemctl --user daemon-reload
  printf 'Removed Kagglebot user services. Configuration files were preserved.\n'
}

case "${command_name}" in
  install) install_services ;;
  start) start_services ;;
  stop) stop_services ;;
  restart) restart_services ;;
  status) status_services ;;
  uninstall) uninstall_services ;;
  *)
    printf 'Usage: %s {install|start|stop|restart|status|uninstall} [--enable-oracle-update]\n' "$0" >&2
    exit 2
    ;;
esac
