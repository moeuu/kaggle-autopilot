# Optional overrides for kagglebot-watch.service.
# Agent models are intentionally not configured here; pyproject.toml is the source of truth.
KAGGLEBOT_WATCH_COMPUTE=local_gpu
KAGGLEBOT_WATCH_HARDWARE_PROFILE=auto
KAGGLEBOT_WATCH_MAX_ITERATIONS=5
# Resource-limited local runs automatically continue as the same run/iteration on Kaggle GPU.
# KAGGLEBOT_LOCAL_TO_KAGGLE_GPU=1
# KAGGLEBOT_KAGGLE_GPU_HANDOFF_PROFILE=kaggle_p100
# KAGGLEBOT_KAGGLE_CLI_MEMORY_LIMIT_MB=8192
# KAGGLEBOT_KAGGLE_WEB_COOKIE_FILE=/home/you/.config/kagglebot/kaggle_web_cookie.txt
# KAGGLEBOT_ORACLE_CHROME_COPY_PROFILE=/home/you/.config/google-chrome
# KAGGLEBOT_ORACLE_CHROME_PROFILE="Default"
# KAGGLEBOT_ORACLE_COMPETITION_DATA=auto
# Use owner-authorized only when the operator has approved their authenticated Oracle session for data processing.
# KAGGLEBOT_ORACLE_COMPETITION_DATA=owner-authorized
# KAGGLEBOT_ORACLE_DATA_ATTACHMENT_MAX_BYTES=104857600
# KAGGLEBOT_REFRESH_EVALUATION_SPEC=0
