# Optional generic Event API sink used by `kagglebot watch`.
KAGGLEBOT_EVENT_SINK_URL=https://events.example.invalid/api/events
KAGGLEBOT_EVENT_SINK_TOKEN=replace-me

# Optional stable public installation label. Do not use a hostname or username.
# KAGGLEBOT_INSTALLATION_ID=worker-01

# Optional tuning. The lease must remain longer than the 30-minute heartbeat.
# KAGGLEBOT_EVENT_SINK_TIMEOUT_SEC=10
# KAGGLEBOT_EVENT_LEASE_SEC=3900
